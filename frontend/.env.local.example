# Leave NEXT_PUBLIC_API_URL unset in local development to use the /api proxy.
# For a deployed backend, set its public API URL, e.g. https://api.example.com/api
BACKEND_URL=http://127.0.0.1:5000
# Same-origin local development uses the /socket.io rewrite above, so leave this unset.
# Only set a public socket origin when it shares the authentication cookie's domain.
# NEXT_PUBLIC_SOCKET_URL=https://api.example.com
